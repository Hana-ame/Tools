[Unit]
Description=Zen Proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /root/zen_proxy.py 0.0.0.0 8443 /root/.acme.sh/*.moonchan.xyz_ecc/fullchain.cer /root/.acme.sh/*.moonchan.xyz_ecc/*.moonchan.xyz.key 30
WorkingDirectory=/root
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
